<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
<div id="background">
    <div id="page" class="container py-4">
        {{> header }}

        <main class="row">
            <section class="col-10 mx-auto">
                <div style="background-color: floralwhite" class="rounded-4 mb-3">
                    <div>
                    <h1 class="m-3 p-3">Shopping Cart</h1>
    
                    <div id="cartContainer" class="row g-4 align-items-start">
                        <div class="col-lg-8 d-flex">
                            <div id="cartList" class="cart-area list-group flex-fill p-3 m-3" aria-live="polite" aria-busy="false">
                            </div>
                        </div>
                    
                        <aside class="col-lg-4 d-flex">
                            <div class="card m-3">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">Summary</h5>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center ">
                                            <div class="text-muted">Subtotal</div>
                                            <div id="cartTotal" class="fw-semibold">$0.00</div>
                                        </div>
                                    </div>
    
                                    <div class="mb-3 text-muted small">
                                        Taxes and shipping calculated at checkout.
                                    </div>
    
                                    <div class="mt-auto d-grid">
                                        <button id="checkoutBtn" class="btn btn-primary btn-lg">Checkout</button>
                                    </div>
                                </div>
                            </div>
                        </aside>
                    </div>
                </div>
            </section>
        </main>

        {{> footer }}
    </div>

    <script src="/javascripts/cart.js"></script>
</div>
</body>
</html>
